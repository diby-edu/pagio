{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pagio-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "pagio-site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8790",
        "-d",
        "server/deploy/site"
      ],
      "port": 8790
    }
  ]
}