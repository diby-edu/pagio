# Copiez ce fichier en .env (ou définissez ces variables chez votre hébergeur).
PORT=8787
# Dossier de la base SQLite, du secret de session et du fichier du premier administrateur.
DATA_DIR=./data
# Secret de signature des sessions (64 caractères aléatoires). Laissez vide : il est généré dans DATA_DIR.
JWT_SECRET=
# Premier administrateur (créé uniquement si aucun n'existe).
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_PASSWORD=
# Chemin de LibreOffice (conversions Word/Excel/PowerPoint haute fidélité). Détecté automatiquement si vide.
SOFFICE_PATH=
# Dossier du tableau de bord construit (par défaut ../dist).
DIST_DIR=
# Clé de chiffrement des secrets stockés en base (clé d'IA, double authentification) : 64 caractères aléatoires.
# Laissez vide : elle est générée dans DATA_DIR/secrets.key. Gardez-en une copie hors du serveur.
SECRETS_KEY=
# Clé du fournisseur d'IA. Si elle est définie ici, elle remplace celle saisie dans le tableau de bord.
AI_API_KEY=
# Nombre de proxys de confiance devant le serveur : 1 derrière Caddy ou Nginx (indispensable pour que les
# limites par adresse IP visent le visiteur et non le proxy). Laissez vide si le serveur est joint directement.
TRUST_PROXY=
