<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="certificates/" />
        <exclude domain="file" path="work/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="certificates/" />
        <exclude domain="file" path="work/" />
    </device-transfer>
</data-extraction-rules>
